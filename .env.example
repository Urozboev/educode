# EduCode — muhit o'zgaruvchilari namunasi
#
# Bu faylni `.env.local` nomi bilan nusxalang va qiymatlarni to'ldiring.
# `.env.local` hech qachon git'ga qo'shilmaydi (.gitignore da).
#
#   cp .env.example .env.local

# ===== Supabase (supabase.com > Project Settings > API) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# DIQQAT: service_role kaliti RLS ni butunlay aylanib o'tadi.
# Faqat serverda ishlatiladi, hech qachon brauzerga uzatilmaydi.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Claude AI (console.anthropic.com) =====
CLAUDE_API_KEY=

# ===== Gemini AI (aistudio.google.com) =====
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_MODEL=gemini-2.0-flash

# ===== Ilova manzili =====
# Ishlab chiqishda: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# ===== Judge0 (RapidAPI) — Playground'da kod bajarish =====
JUDGE0_RAPIDAPI_KEY=
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# ===== Bunny Stream — himoyalangan video hosting =====
# Batafsil: VIDEO-HOSTING.md
# 1) bunny.net > Stream > Add Video Library
# 2) Library > API > "Video Library ID"
BUNNY_STREAM_LIBRARY_ID=
# 3) Library > Security > "Token Authentication" ni yoqing va kalitni oling
BUNNY_STREAM_TOKEN_KEY=
# Video ro'yxatini boshqarish uchun akkaunt API kaliti
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=

# ===== To'lov: Payme (business.payme.uz) =====
# Dashboard'da Endpoint URL: https://<domen>/api/payments/payme
PAYME_MERCHANT_ID=
PAYME_KEY=

# ===== To'lov: Click (merchant.click.uz) =====
# Dashboard'da Prepare/Complete URL: https://<domen>/api/payments/click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
